{
  "name": "@absolutejs/product-analytics",
  "version": "0.6.0",
  "description": "Consent-aware first-party product engagement collection and session contracts.",
  "type": "module",
  "license": "BSL-1.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/client.ts --outdir dist --target browser && tsc -p tsconfig.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test:browser": "node tests/browser.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/bun": "1.3.11",
    "@playwright/test": "1.60.0"
  }
}
