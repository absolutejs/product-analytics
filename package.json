{
  "name": "@absolutejs/product-analytics",
  "version": "0.6.2",
  "description": "Consent-aware first-party product engagement collection and session contracts.",
  "type": "module",
  "license": "BUSL-1.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "changelog.json",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/client.ts --outdir dist --target browser && tsc -p tsconfig.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test:browser": "node tests/browser.cjs",
    "package": "bun scripts/package.ts",
    "check:package": "bun run typecheck && bun test && bun run build && absolute-changelog check",
    "prepublishOnly": "bun run check:package"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@absolutejs/changelog": "^0.6.0",
    "@playwright/test": "1.60.0",
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/absolutejs/product-analytics.git"
  }
}
